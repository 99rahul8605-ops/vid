BOT_TOKEN=
ADMIN_ID=
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=video_unlock_bot
STORAGE_CHANNEL_ID=
DELETE_AFTER_HOURS=12
REFERRALS_PER_BATCH=1

# How long a captured join request is accepted as pending
PENDING_REQUEST_TTL_HOURS=72

# Storage copying is always one worker; any OLD UPLOAD_CONCURRENCY setting is ignored.
# Minimum delay after each storage-copy attempt before sending another.
UPLOAD_CONCURRENCY=1
UPLOAD_DELAY_SECONDS=2
# Backward-compatible alias: UPLOAD_COPY_GAP_SECONDS=2
UPLOAD_MAX_RETRIES=5

# Update the same live upload status message every N seconds.
UPLOAD_PROGRESS_REFRESH_SECONDS=3
